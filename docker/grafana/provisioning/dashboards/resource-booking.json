{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "JVM memory used",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (area) (jvm_memory_used_bytes)", "legendFormat": "{{area}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "JVM heap utilization",
      "type": "timeseries",
      "targets": [
        { "expr": "100 * sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "Heap used %", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "JVM threads",
      "type": "timeseries",
      "targets": [
        { "expr": "jvm_threads_live_threads", "legendFormat": "Live", "refId": "A" },
        { "expr": "jvm_threads_daemon_threads", "legendFormat": "Daemon", "refId": "B" },
        { "expr": "jvm_threads_peak_threads", "legendFormat": "Peak", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Process and system CPU",
      "type": "timeseries",
      "targets": [
        { "expr": "100 * process_cpu_usage", "legendFormat": "Process CPU", "refId": "A" },
        { "expr": "100 * system_cpu_usage", "legendFormat": "System CPU", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "title": "GC pause rate",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (action) (rate(jvm_gc_pause_seconds_sum[5m]))", "legendFormat": "{{action}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "title": "JVM uptime",
      "type": "timeseries",
      "targets": [
        { "expr": "process_uptime_seconds", "legendFormat": "Uptime", "refId": "A" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["actuator", "jvm"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Resource Booking JVM Metrics",
  "uid": "resource-booking",
  "version": 1
}
